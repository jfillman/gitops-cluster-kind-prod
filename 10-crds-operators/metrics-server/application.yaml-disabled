# Applied proactively 2026-08-26, mirroring gitops-cluster-dev's own
# 10-crds-operators/metrics-server/ - that install was added after metrics-server
# was found missing entirely on kind-dev, which left every HPA on the cluster
# permanently stuck `cannot-scale` (pods.metrics.k8s.io APIService didn't exist).
# Same gap applies to any kind cluster, so applied here ahead of it being discovered
# broken rather than after.
#
# --kubelet-insecure-tls: kind nodes' kubelet serving certs aren't signed for a SAN
# metrics-server's default TLS verification accepts (same class of self-signed-cert
# issue every kind-cluster metrics-server install hits, not specific to this repo).
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: metrics-server
  namespace: argocd
  labels:
    platform.io/component: cluster-config
    platform.io/subcomponent: crds-operators
spec:
  project: default
  source:
    repoURL: https://kubernetes-sigs.github.io/metrics-server/
    chart: metrics-server
    targetRevision: "3.14.0"
    helm:
      releaseName: metrics-server
      valuesObject:
        args:
          - --kubelet-insecure-tls
  destination:
    server: https://kubernetes.default.svc
    namespace: kube-system
  syncPolicy:
    automated:
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - ServerSideApply=true
